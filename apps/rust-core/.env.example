# eduforge-core runtime env — copy to .env, fill real values.
# All keys are fail-closed: missing required var -> process refuses to start.

# --- required (no default) ---
FORGE_DATABASE_URL=postgres://forge:forge@127.0.0.1:5432/forge
FORGE_HMAC_SECRET=change-me-64-bytes
FORGE_ALIPAY_PUBLIC_KEY_PEM=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----
FORGE_STRIPE_WEBHOOK_SECRET=whsec_change_me
FORGE_COINBASE_WEBHOOK_SECRET=ck_change_me

# --- optional (defaults shown) ---
FORGE_BIND_ADDR=0.0.0.0:8080
FORGE_NATS_URL=nats://127.0.0.1:4222
FORGE_CARD_ACQUIRER=braintree
FORGE_ADMIN_TOKEN=change-me-admin-bearer
# 连接池上限; 本地 PGlite(WASM PG, 单 backend) 环境建议设 1, 生产保持默认 8
# FORGE_DB_MAX_CONNS=8

# WeChat / PayPal / Braintree / Adyen — leave empty to disable those gateways
# FORGE_WECHAT_PLATFORM_CERT_PEM=
# FORGE_WECHAT_API_V3_KEY=
# FORGE_PAYPAL_WEBHOOK_SECRET=
# FORGE_BRAINTREE_MERCHANT_ID=
# FORGE_BRAINTREE_WEBHOOK_SECRET=
# FORGE_ADYEN_HMAC_KEY=
# FORGE_ADYEN_MERCHANT_ACCOUNT=
